    "Map of Weapon-Use Incidents": {
      "type": "object",
      "description": "Map of weapon-use incidents. Use the Groupby setting to color points by event type, event ID, or any other available attribute.",
      "ecoscope:task_group": true,
      "properties": {
        "weapon_events_colormap": {
          "additionalProperties": false,
          "properties": {
            "input_column_name": {
              "title": "Groupby",
              "type": "string",
              "description": "Color incidents on the map by the selected attribute. Each unique value is assigned a distinct color.",
              "default": "event_type_display",
              "ecoscope:advanced": false,
              "oneOf": [
                {
                  "const": "event_type_display",
