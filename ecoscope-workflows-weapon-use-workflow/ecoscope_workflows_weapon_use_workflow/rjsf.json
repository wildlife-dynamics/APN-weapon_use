        "weapon_map_layer"
      ],
      "weapon_events_colormap": {
        "ui:order": [
          "input_column_name",
          "colormap",
          "custom_colors"
        ]
      },
      "weapon_map_layer": {
        "layer_style": {
          "get_fill_color": {
            "ui:widget": "hidden"
          },
          "get_line_color": {
            "ui:widget": "hidden"
          },
          "get_position": {
            "ui:widget": "hidden"
          }
        }
      }
    },
    "Ammunition Summary Table": {
      "ammo_table": {
        "ui:order": [
          "columns",
          "table_config"
        ]
      }
    },
    "Personnel Activity Table": {
      "personnel_table": {
        "ui:order": [
          "columns",
          "table_config"
        ]
      }
    },
    "Agresion Breakdown": {
      "lesiones_table": {
        "ui:order": [
          "columns",
          "table_config"
        ]
      }
    },
    "ui:order": [
      "workflow_details",
      "er_client",
      "base_maps",
      "time_range",
      "plot_palette",
      "events",
      "Spatial Features",
      "Local Spatial Features",
      "Map of Weapon-Use Incidents",
      "Trends Over Time",
      "Ammunition Summary Table",
      "Personnel Activity Table",
      "Agresion Breakdown"
    ]
  },
  "additionalProperties": false
}
