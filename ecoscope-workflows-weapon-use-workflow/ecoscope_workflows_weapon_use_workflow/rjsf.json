      "type": "object",
      "description": "Details specific to 'Agresi\u00f3n / amenaza a funcionario' events.",
      "ecoscope:task_group": true,
      "properties": {
        "lesiones_table": {
          "additionalProperties": false,
          "properties": {
            "columns": {
              "default": null,
              "items": {
                "type": "string"
              },
              "title": "Columns",
              "type": "array",
              "description": "The list of dataframe columns to render in the table. Leave empty to render all columns",
              "ecoscope:advanced": true
            },
            "table_config": {
              "allOf": [
                {
                  "$ref": "#/$defs/TableConfig"
                }
              ],
              "default": null,
              "title": "Table Config",
              "description": "Configuration options for the table.",
              "ecoscope:advanced": true,
              "properties": {
                "enable_sorting": {
                  "default": true
                },
                "enable_filtering": {
                  "default": true
                },
                "enable_download": {
                  "default": true
                }
              }
            }
          },
          "required": [],
          "type": "object",
          "title": ""
        }
      }
    }
  },
  "$defs": {
    "EarthRangerConnection": {
      "properties": {
        "name": {
          "title": "Data Source",
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "title": "EarthRangerConnection",
      "type": "object"
    },
    "TimezoneInfo": {
      "properties": {
        "label": {
          "title": "Label",
          "type": "string"
        },
        "tzCode": {
          "title": "Tzcode",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "utc": {
          "title": "Utc",
          "type": "string"
        }
      },
      "required": [
        "label",
        "tzCode",
        "name",
        "utc"
      ],
      "title": "TimezoneInfo",
      "type": "object"
    },
    "QualitativeColormap": {
      "description": "Matplotlib qualitative palettes \u2014 designed for unordered categorical data.",
      "enum": [
        "Pastel1",
        "Pastel2",
        "Paired",
        "Accent",
        "Dark2",
        "Set1",
        "Set2",
        "Set3",
        "tab10",
        "tab20",
        "tab20b",
        "tab20c"
      ],
      "title": "QualitativeColormap",
      "type": "string"
    },
    "EarthRangerSource": {
      "title": "EarthRanger",
      "type": "object",
      "properties": {
        "query": {
          "title": "Query",
          "default": null,
          "anyOf": [
            {
              "type": "null",
              "title": "--- select ---"
            },
            {
              "$ref": "#/$defs/FeatureSetQuery"
            },
            {
              "$ref": "#/$defs/FeatureTypeQuery"
            },
            {
              "$ref": "#/$defs/FeatureIdQuery"
            }
          ]
        }
      }
    },
    "FeatureIdQuery": {
      "description": "Load a single spatial feature by its EarthRanger UUID.",
      "properties": {
        "feature_id": {
          "description": "UUID of a specific spatial feature available on EarthRanger.",
          "title": "Feature Id",
          "type": "string"
        },
        "style": {
          "default": [],
          "description": "Optional: Override how EarthRanger spatial features are rendered on the map. If not specified, features will use their native EarthRanger colours and styling.",
          "items": {
            "$ref": "#/$defs/LayerStyle"
          },
          "maxItems": 1,
          "title": "Style",
          "type": "array"
        }
      },
      "required": [
        "feature_id"
      ],
      "title": "Feature ID",
      "type": "object"
    },
    "FeatureSetQuery": {
      "description": "Load all features from a named EarthRanger featureset.",
      "properties": {
        "featureset_name": {
          "description": "Display name of the featureset exactly as it appears in EarthRanger e.g. 'Boundaries'.",
          "minLength": 1,
          "title": "Featureset Name",
          "type": "string"
        }
      },
      "required": [
        "featureset_name"
      ],
      "title": "Feature Set",
      "type": "object"
    },
    "FeatureTypeQuery": {
      "description": "Load all features of a given type across EarthRanger featuresets.",
      "properties": {
        "feature_type": {
          "description": "Feature type name as shown in EarthRanger e.g. 'Conservancy'.",
          "minLength": 1,
          "title": "Feature Type",
          "type": "string"
        },
        "style": {
          "default": [],
          "description": "Optional: Override how EarthRanger spatial features are rendered on the map. If not specified, features will use their native EarthRanger colours and styling.",
          "items": {
            "$ref": "#/$defs/LayerStyle"
          },
          "maxItems": 1,
          "title": "Style",
          "type": "array"
        }
      },
      "required": [
        "feature_type"
      ],
      "title": "Feature Type",
      "type": "object"
    },
    "LayerStyle": {
      "properties": {
        "polygon": {
          "default": [],
          "description": "Polygon styling. Add one entry to override ER native colours.",
          "items": {
            "$ref": "#/$defs/PolygonStyle"
          },
          "maxItems": 1,
          "title": "Polygon",
          "type": "array"
        },
        "line": {
          "default": [],
          "description": "Line styling. Add one entry to override ER native colours.",
          "items": {
            "$ref": "#/$defs/LineStyle"
          },
          "maxItems": 1,
          "title": "Line",
          "type": "array"
        },
        "point": {
          "default": [],
          "description": "Point and icon marker styling. Add one entry to override ER native colours.",
          "items": {
            "$ref": "#/$defs/PointStyle"
          },
          "maxItems": 1,
          "title": "Point",
          "type": "array"
        }
      },
      "title": "",
      "type": "object"
    },
    "LineStyle": {
      "properties": {
        "color": {
          "default": [],
          "description": "Line hex colour(s) e.g. ['#E63946']. Cycles across rows.",
          "items": {
            "type": "string"
          },
          "title": "Color",
          "type": "array"
        },
        "opacity": {
          "default": 1.0,
          "description": "Line opacity 0\u20131.",
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Opacity",
          "type": "number"
        },
        "width": {
          "default": 2.0,
          "description": "Line width in pixels.",
          "title": "Width",
          "type": "number"
        }
      },
      "title": "",
      "type": "object"
    },
    "PointStyle": {
      "properties": {
        "color": {
          "default": [],
          "description": "Fill hex colour(s). For SVG icons this tints the marker. Cycles across rows.",
          "items": {
            "type": "string"
          },
          "title": "Color",
          "type": "array"
        },
        "size": {
          "default": null,
          "description": "Point radius / icon size in pixels. Leave empty to use the size set in EarthRanger.",
          "title": "Size",
          "type": "number"
        }
      },
      "title": "",
      "type": "object"
    },
    "PolygonStyle": {
      "properties": {
        "fill_color": {
          "default": [],
          "description": "Fill hex colour(s) e.g. ['#FFA500']. Cycles across rows.",
          "items": {
            "type": "string"
          },
          "title": "Fill Color",
          "type": "array"
        },
        "stroke_color": {
          "default": null,
          "description": "Border hex colour.",
          "title": "Stroke Color",
          "type": "string"
        },
        "fill_opacity": {
          "default": 1.0,
          "description": "Fill opacity 0\u20131.",
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Fill Opacity",
          "type": "number"
        },
        "stroke_width": {
          "default": 2.0,
          "description": "Border width in pixels.",
          "title": "Stroke Width",
          "type": "number"
        }
      },
      "title": "",
      "type": "object"
    },
    "ScatterplotLayerStyle": {
      "description": "Scatterplot Layer style kwargs\nSee https://deck.gl/docs/api-reference/layers/scatterplot-layer for more info",
      "properties": {
        "auto_highlight": {
          "default": false,
          "ecoscope:advanced": true,
          "title": "Auto Highlight",
          "type": "boolean"
        },
        "opacity": {
          "default": 1,
          "ecoscope:advanced": true,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Opacity",
          "type": "number"
        },
        "pickable": {
          "default": true,
          "ecoscope:advanced": true,
          "title": "Pickable",
          "type": "boolean"
        },
        "get_position": {
          "default": "geometry.coordinates",
          "ecoscope:advanced": true,
          "title": "Get Position",
          "type": "string"
        },
        "get_fill_color": {
          "default": null,
          "ecoscope:advanced": true,
          "title": "Get Fill Color",
          "type": "string"
        },
        "get_line_color": {
          "default": null,
          "ecoscope:advanced": true,
          "title": "Get Line Color",
          "type": "string"
        },
        "get_radius": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "number"
            }
          ],
          "default": 5,
          "ecoscope:advanced": true,
          "title": "Get Radius"
        },
        "get_line_width": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "number"
            }
          ],
          "default": 1,
          "ecoscope:advanced": true,
          "title": "Get Line Width"
        },
        "get_elevation": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "number"
            }
          ],
          "default": null,
          "ecoscope:advanced": true,
          "title": "Get Elevation"
        },
        "radius_units": {
          "default": "pixels",
          "ecoscope:advanced": true,
          "enum": [
            "meters",
            "pixels"
          ],
          "title": "Radius Units",
          "type": "string"
        },
        "radius_scale": {
          "default": 1,
          "ecoscope:advanced": true,
          "title": "Radius Scale",
          "type": "number"
        },
        "radius_min_pixels": {
          "default": 0,
          "ecoscope:advanced": true,
          "title": "Radius Min Pixels",
          "type": "number"
        },
        "radius_max_pixels": {
          "default": null,
          "ecoscope:advanced": true,
          "title": "Radius Max Pixels",
          "type": "number"
        },
        "line_width_units": {
          "default": "pixels",
          "ecoscope:advanced": true,
          "enum": [
            "meters",
            "pixels"
          ],
          "title": "Line Width Units",
          "type": "string"
        },
        "line_width_scale": {
          "default": 1,
          "ecoscope:advanced": true,
          "title": "Line Width Scale",
          "type": "number"
        },
        "line_width_min_pixels": {
          "default": 0,
          "ecoscope:advanced": true,
          "title": "Line Width Min Pixels",
          "type": "number"
        },
        "line_width_max_pixels": {
          "default": null,
          "ecoscope:advanced": true,
          "title": "Line Width Max Pixels",
          "type": "number"
        },
        "stroked": {
          "default": false,
          "ecoscope:advanced": true,
          "title": "Stroked",
          "type": "boolean"
        },
        "filled": {
          "default": true,
          "ecoscope:advanced": true,
          "title": "Filled",
          "type": "boolean"
        },
        "elevation_scale": {
          "default": 1,
          "ecoscope:advanced": true,
          "title": "Elevation Scale",
          "type": "number"
        },
        "billboard": {
          "default": false,
          "ecoscope:advanced": true,
          "title": "Billboard",
          "type": "boolean"
        }
      },
      "title": "ScatterplotLayerStyle",
      "type": "object"
    },
    "TableConfig": {
      "properties": {
        "enable_sorting": {
          "default": true,
          "title": "Enable Sorting",
          "type": "boolean"
        },
        "enable_filtering": {
          "default": false,
          "title": "Enable Filtering",
          "type": "boolean"
        },
        "enable_download": {
          "default": false,
          "title": "Enable Download",
          "type": "boolean"
        },
        "hide_header": {
          "default": false,
          "title": "Hide Header",
          "type": "boolean"
        }
      },
      "title": "TableConfig",
      "type": "object"
    }
  },
  "uiSchema": {
    "workflow_details": {
      "ui:order": [
        "name",
        "description"
      ]
    },
    "time_range": {
      "ui:order": [
        "since",
        "until",
        "timezone"
      ]
    },
    "plot_palette": {
      "ui:order": [
        "colormap",
        "custom_colors"
      ]
    },
    "Spatial Features": {
      "spatial_features": {
        "ui:order": [
          "source",
          "group_by",
          "legend_title"
        ],
        "source": {
          "ui:options": {
            "label": false
          },
          "query": {
            "ui:options": {
              "label": false
            },
            "anyOf": [
              {
                "ui:options": {
                  "label": false
                }
              },
              {
                "ui:options": {
                  "label": false
                }
              },
              {
                "ui:options": {
                  "label": false
                }
              }
            ]
          }
        },
        "legend_title": {
          "ui:placeholder": "e.g. Park Boundary"
        }
      }
    },
    "Local Spatial Features": {
      "local_spatial_file": {
        "ui:order": [
          "file_path",
          "layer",
          "group_by",
