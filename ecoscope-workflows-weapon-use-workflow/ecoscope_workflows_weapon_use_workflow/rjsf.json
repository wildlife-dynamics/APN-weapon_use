            "colormap": {
              "allOf": [
                {
                  "$ref": "#/$defs/QualitativeColormap"
                }
              ],
              "default": "Set1",
              "title": "Palette",
              "description": "Select a color palette for the map markers. Use Set1, Set2, or Dark2 for a small number of categories; use tab20, tab20b, or tab20c when you have many.",
              "ecoscope:advanced": false
            },
            "custom_colors": {
              "items": {
                "type": "string"
              },
              "title": "Custom Colors",
              "type": "array",
              "description": "Optional. Provide one hex color per category (e.g. #e41a1c, #377eb8). Leave empty to use the palette above.",
              "ecoscope:advanced": false
            }
          },
          "required": [
            "input_column_name"
          ],
          "type": "object",
          "title": ""
        },
        "weapon_legend_title": {
          "additionalProperties": false,
          "properties": {
            "var": {
              "title": "Title",
              "type": "string",
              "description": "Legend title for the weapon-use incidents map.",
              "default": "Legend",
              "ecoscope:advanced": false
            }
          },
          "required": [
            "var"
          ],
          "type": "object",
          "title": ""
        },
        "weapon_map_layer": {
          "additionalProperties": false,
          "properties": {
            "layer_style": {
              "allOf": [
                {
                  "$ref": "#/$defs/ScatterplotLayerStyle"
                }
              ],
              "default": {
                "auto_highlight": false,
                "opacity": 1,
                "pickable": true,
                "get_position": "geometry.coordinates",
                "get_fill_color": null,
                "get_line_color": null,
                "get_radius": 5,
                "get_line_width": 1,
                "get_elevation": null,
                "radius_units": "pixels",
                "radius_scale": 1,
                "radius_min_pixels": 0,
                "radius_max_pixels": null,
                "line_width_units": "pixels",
                "line_width_scale": 1,
                "line_width_min_pixels": 0,
                "line_width_max_pixels": null,
                "stroked": false,
                "filled": true,
                "elevation_scale": 1,
                "billboard": false
              },
              "title": "Layer Style",
              "description": "",
              "ecoscope:advanced": true,
              "properties": {
                "auto_highlight": {
                  "type": "boolean",
                  "default": true,
                  "title": "Auto Highlight",
                  "description": "Enable automatic highlighting when hovering over a marker.",
                  "ecoscope:advanced": true
                },
                "opacity": {
                  "type": "number",
                  "default": 0.9,
                  "title": "Opacity",
                  "description": "Transparency of the markers, from 0 (invisible) to 1 (fully opaque).",
                  "ecoscope:advanced": true
                },
                "pickable": {
                  "type": "boolean",
                  "default": true,
                  "title": "Pickable",
                  "description": "Allow markers to be interactive (hoverable and clickable).",
                  "ecoscope:advanced": true
                },
                "get_position": {
                  "type": "string",
                  "default": "geometry.coordinates",
                  "title": "Position",
                  "description": "Column or expression used to determine the marker position on the map.",
                  "ecoscope:advanced": true
                },
                "get_fill_color": {
                  "type": "string",
                  "default": "column_color",
                  "title": "Fill Color",
                  "description": "Column used for marker fill color. Defaults to the colormap output.",
                  "enum": [
                    "column_color"
                  ],
                  "ecoscope:advanced": true
                },
                "get_radius": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "default": 8,
                      "title": "Radius Size"
                    }
                  ],
                  "default": 8,
                  "title": "Radius",
                  "description": "Size of each incident marker.",
                  "ecoscope:advanced": true
                },
                "get_line_width": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "default": 1,
                      "title": "Line Width Size"
                    }
                  ],
                  "default": 1,
                  "title": "Line Width",
                  "description": "Width of the marker outline when Stroked is enabled.",
                  "ecoscope:advanced": true
                },
                "get_elevation": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "default": 0,
                      "title": "Elevation Height"
                    }
                  ],
                  "default": 0,
                  "title": "Elevation",
                  "description": "Height of each marker for 3D visualisation.",
                  "ecoscope:advanced": true
                },
                "radius_units": {
                  "type": "string",
                  "default": "pixels",
                  "title": "Radius Units",
                  "description": "Units for the marker radius \u2014 pixels (screen-space) or meters (world-space).",
                  "enum": [
                    "meters",
                    "pixels"
                  ],
                  "ecoscope:advanced": true
                },
                "radius_scale": {
                  "type": "number",
                  "default": 1,
                  "title": "Radius Scale",
                  "description": "Global multiplier applied to all marker radii.",
                  "ecoscope:advanced": true
                },
                "radius_min_pixels": {
                  "type": "number",
                  "default": 0,
                  "title": "Radius Min Pixels",
                  "description": "Minimum radius size in pixels regardless of zoom level.",
                  "ecoscope:advanced": true
                },
                "radius_max_pixels": {
                  "type": "number",
                  "default": 9999,
                  "title": "Radius Max Pixels",
                  "description": "Maximum radius size in pixels regardless of zoom level.",
                  "ecoscope:advanced": true
                },
                "line_width_units": {
                  "type": "string",
                  "default": "pixels",
                  "title": "Line Width Units",
                  "description": "Units for the outline width \u2014 pixels (screen-space) or meters (world-space).",
                  "enum": [
                    "meters",
                    "pixels"
                  ],
                  "ecoscope:advanced": true
                },
                "line_width_scale": {
                  "type": "number",
                  "default": 1,
                  "title": "Line Width Scale",
                  "description": "Global multiplier applied to all outline widths.",
                  "ecoscope:advanced": true
                },
                "line_width_min_pixels": {
                  "type": "number",
                  "default": 0,
                  "title": "Line Width Min Pixels",
                  "description": "Minimum outline width in pixels regardless of zoom level.",
                  "ecoscope:advanced": true
                },
                "line_width_max_pixels": {
                  "type": "number",
                  "default": 9999,
                  "title": "Line Width Max Pixels",
                  "description": "Maximum outline width in pixels regardless of zoom level.",
                  "ecoscope:advanced": true
                },
                "stroked": {
                  "type": "boolean",
                  "default": false,
                  "title": "Stroked",
                  "description": "Draw a border outline around each marker.",
                  "ecoscope:advanced": true
                },
                "filled": {
                  "type": "boolean",
                  "default": true,
                  "title": "Filled",
                  "description": "Fill the interior of each marker with color.",
                  "ecoscope:advanced": true
                },
                "elevation_scale": {
                  "type": "number",
                  "default": 1,
                  "title": "Elevation Scale",
                  "description": "Global multiplier applied to the elevation value for 3D visualisation.",
                  "ecoscope:advanced": true
                },
                "billboard": {
                  "type": "boolean",
                  "default": false,
                  "title": "Billboard",
                  "description": "Always face the marker toward the camera regardless of map tilt.",
                  "ecoscope:advanced": true
                }
              }
            }
          },
          "type": "object",
          "required": [],
          "title": "Create Weapon Events Map Layer"
        }
      }
    },
